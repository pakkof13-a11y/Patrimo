// Aurea — PostgreSQL schema
// Holdings from transactions; cash pockets (banks, envelopes) are explicit & optional.

generator client {
  provider = "prisma-client"
  output   = "../app/lib/prisma-client"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js / NextAuth ───────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  /// Login unique (identifiant de connexion)
  username      String    @unique
  email         String    @unique
  name          String?
  passwordHash  String?
  /// ADMIN = SuperUser · USER = compte isolé
  role          String    @default("USER")
  emailVerified DateTime?
  image         String?
  baseCurrency  String    @default("EUR")
  /// Situation fiscale du foyer pour l'abattement AV : SINGLE | COUPLE
  taxHousehold  String    @default("SINGLE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts               Account[]
  sessions               Session[]
  platforms              Platform[]
  assets                 Asset[]
  snapshots              PortfolioSnapshot[]
  liabilities            Liability[]
  bankAccounts           BankAccount[]
  savingsAccounts        SavingsAccount[]
  termDeposits           TermDeposit[]
  lifeInsurances         LifeInsurance[]
  envelopeCash           EnvelopeCash[]
  employeeSavingsLines   EmployeeSavingsLine[]
  preciousMetalPositions PreciousMetalPosition[]
  preciousMetalSales     PreciousMetalSale[]
  privateEquityPositions PrivateEquityPosition[]
  crowdlendingPositions  CrowdlendingPosition[]
  tangibleAssets         TangibleAsset[]
  tradingPositions       TradingPosition[]
  defiStrategies         DefiStrategy[]
  securitiesAccounts     SecuritiesAccount[]
  tradingAccounts        TradingAccount[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domain ───────────────────────────────────────────────────────────────────

model Platform {
  id                 String    @id @default(cuid())
  userId             String
  name               String
  /// COURTIER | EXCHANGE_CRYPTO | BANQUE | BLOCKCHAIN | …
  type               String    @default("COURTIER")
  /// Optional nuance, e.g. "Layer 1" | "Layer 2 / EVM" for blockchains
  subtype            String?
  logoKey            String?
  logoUrl            String?
  walletAddress      String?
  /// Clé API GoldRush (Covalent) optionnelle par plateforme — défaut serveur sinon
  walletApiKey       String?
  notes              String?
  /// Curseur sync Solana RPC : dernière signature connue (plus récente)
  lastKnownSignature String?
  /// Dernière synchro on-chain réussie (soldes et/ou txs)
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets             Asset[]
  transactionsFrom   Transaction[]         @relation("TxPlatform")
  transactionsTo     Transaction[]         @relation("TxToPlatform")
  onchainTxs         BlockchainOnchainTx[]
  securitiesAccounts SecuritiesAccount[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, type])
}

/// Transactions on-chain Solana (RPC natif) — distinctes du journal ledger Aurea.
model BlockchainOnchainTx {
  id               String    @id @default(cuid())
  userId           String
  platformId       String
  signature        String
  slot             BigInt?
  blockTime        DateTime?
  status           String    @default("unknown")
  /// TRANSFER | SWAP_LIKE | STAKE_LIKE | FAILED | UNKNOWN
  type             String?
  feeLamports      BigInt?
  primaryProgramId String?
  programIds       Json?
  transfers        Json?
  rawParsed        Json?
  err              String?
  createdAt        DateTime  @default(now())

  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([platformId, signature])
  @@index([userId, platformId])
  @@index([platformId, blockTime])
  @@index([signature])
}

/// Sous-catégorie d’affichage (UI) — indépendante des calculs ledger / assetClass.
enum AssetCategory {
  EQUITY
  ETF
  BOND
  MONEY_MARKET
  FUND
  REIT
  CRYPTO
  CASH_EQUIVALENT
  SCPI
  REAL_ESTATE_DIRECT
  PRIVATE_EQUITY
  COMMODITY
  DERIVATIVE
  OTHER
  UNCLASSIFIED
}

model Asset {
  id                  String        @id @default(cuid())
  userId              String
  platformId          String
  name                String
  ticker              String?
  /// Code ISIN (actions / ETF) — recherche & affichage
  isin                String?
  assetClass          String
  /// Sous-catégorie UI (regroupement Positions) — n’affecte pas les calculs
  category            AssetCategory @default(UNCLASSIFIED)
  currency            String        @default("EUR")
  /// ISO 3166-1 alpha-2 (US, DE, FR…) — WHT dividendes
  countryCode         String?
  /// Override taux prélèvement à la source 0–1 (null = table pays)
  withholdingTaxRate  Decimal?      @db.Decimal(8, 6)
  /// Fiscal / storage envelope: CTO | PEA | AV | CRYPTO | IMMOBILIER
  accountType         String        @default("CTO")
  /// Compte titres de rattachement (PEA / PEA-PME / CTO). Nullable : les
  /// actifs antérieurs à l'onglet « PEA & CTO » restent rattachés à leur
  /// seule `platform`, et `accountType` continue de porter l'enveloppe
  /// fiscale — ce champ ne fait que désigner *lequel* des comptes de cette
  /// enveloppe détient la ligne, ce qu'une chaîne ne pouvait pas exprimer
  /// dès lors qu'un utilisateur détient plusieurs CTO.
  securitiesAccountId String?
  priceProvider       String        @default("FINNHUB")
  providerSymbol      String?
  logoUrl             String?
  notes               String?
  manualPrice         Decimal?      @db.Decimal(28, 12)
  /// Exit levels in asset native currency (long): auto-sell on price refresh
  stopLoss            Decimal?      @db.Decimal(28, 12)
  tp1                 Decimal?      @db.Decimal(28, 12)
  tp2                 Decimal?      @db.Decimal(28, 12)
  tp3                 Decimal?      @db.Decimal(28, 12)
  tp4                 Decimal?      @db.Decimal(28, 12)
  acquisitionDate     DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform           Platform                  @relation(fields: [platformId], references: [id], onDelete: Restrict)
  transactions       Transaction[]
  priceQuote         PriceQuote?
  priceHistory       PriceHistory[]
  dailyCloses        AssetDailyClose[]
  realEstate         RealEstateDetail?
  indirectRealEstate IndirectRealEstateDetail?
  defiPosition       DefiPositionDetail?
  nftItem            NftItemDetail?
  lifeSupport        LifeInsuranceSupport?
  liabilities        Liability[]
  securitiesAccount  SecuritiesAccount?        @relation(fields: [securitiesAccountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([platformId])
  @@index([userId, assetClass])
  @@index([userId, accountType])
  @@index([userId, category])
  @@index([isin])
  @@index([securitiesAccountId])
}

model Transaction {
  id     String @id @default(cuid())
  userId String

  type String

  platformId   String
  toPlatformId String?
  assetId      String?

  quantity  Decimal? @db.Decimal(28, 12)
  unitPrice Decimal? @db.Decimal(28, 12)
  fees      Decimal  @default(0) @db.Decimal(28, 12)

  currency    String  @default("EUR")
  fxRateToEur Decimal @default(1) @db.Decimal(20, 10)

  grossAmountEur     Decimal   @db.Decimal(28, 12)
  feesEur            Decimal   @default(0) @db.Decimal(28, 12)
  netCashImpactEur   Decimal   @db.Decimal(28, 12)
  /// Prélèvement à la source (WHT) en EUR — snapshot à la création
  withholdingTaxEur  Decimal   @default(0) @db.Decimal(28, 12)
  /// Taux WHT appliqué (0–1), snapshot
  withholdingTaxRate Decimal?  @db.Decimal(8, 6)
  /// Date de détachement (cours) — optionnel
  exDate             DateTime?
  /// Date de paiement cash (défaut = occurredAt)
  paymentDate        DateTime?

  occurredAt DateTime
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  platform   Platform  @relation("TxPlatform", fields: [platformId], references: [id], onDelete: Restrict)
  toPlatform Platform? @relation("TxToPlatform", fields: [toPlatformId], references: [id], onDelete: Restrict)
  asset      Asset?    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([userId, occurredAt])
  @@index([platformId, occurredAt])
  @@index([assetId, occurredAt])
  @@index([userId, type])
}

model PriceQuote {
  id             String   @id @default(cuid())
  assetId        String   @unique
  priceNative    Decimal  @db.Decimal(28, 12)
  nativeCurrency String   @default("EUR")
  priceEur       Decimal  @db.Decimal(28, 12)
  source         String
  status         String   @default("OK")
  lastUpdatedAt  DateTime
  rawError       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model PriceHistory {
  id         String   @id @default(cuid())
  assetId    String
  priceEur   Decimal  @db.Decimal(28, 12)
  source     String
  capturedAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, capturedAt])
}

/// Clôture journalière d'un actif, en EUR — cache alimenté depuis les
/// fournisseurs de cours (barres 1d). Sert à valoriser l'historique au marché
/// pour le P&L par classe d'actif, que `PriceHistory` ne permet pas : cette
/// dernière n'enregistre que des captures spot au moment des rafraîchissements,
/// donc creuse et irrégulière.
/// Ce n'est qu'un cache : il peut être vidé et reconstruit sans perte, la
/// source de vérité restant les transactions.
model AssetDailyClose {
  id        String   @id @default(cuid())
  assetId   String
  /// Jour civil Europe/Paris, format YYYY-MM-DD (tri lexicographique = chronologique)
  day       String
  closeEur  Decimal  @db.Decimal(28, 12)
  source    String
  fetchedAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, day])
  @@index([assetId, day])
}

/// Caractéristiques d'un bien immobilier détenu en direct — extension 1:1 de
/// `Asset`, sur le modèle de `PriceQuote`.
///
/// Ces champs vivent à part plutôt que sur `Asset` : ils ne concernent qu'une
/// poignée de lignes, et les porter sur le modèle central imposerait vingt-cinq
/// colonnes vides à chaque action et chaque crypto.
///
/// **La quote-part n'est pas ici** : elle est portée par la `quantity` des
/// transactions, donc par la position elle-même. Un bien détenu à 50 % est une
/// position de 0,5 unité valorisée au prix du bien entier. La valeur au
/// patrimoine s'en déduit sans qu'aucun calcul n'ait à se souvenir de diviser,
/// et un rachat de part se traite comme un second achat.
model RealEstateDetail {
  id      String @id @default(cuid())
  assetId String @unique

  /// MAISON | APPARTEMENT | PARKING | TERRAIN | LOCAL_COMMERCIAL | AUTRE
  propertyType String
  /// RESIDENCE_PRINCIPALE | RESIDENCE_SECONDAIRE | LOCATIF_NU | LOCATIF_MEUBLE
  /// | LOCATIF_SAISONNIER | MIXTE | AUTRE
  usage        String

  rooms        Int?
  /// Surface habitable (loi Carrez pour les lots de copropriété)
  livingAreaM2 Int?
  landAreaM2   Int?

  // ── Adresse — nécessaire au rapprochement DVF ──
  addressLine String?
  postalCode  String?
  city        String?
  inseeCode   String?
  /// Issues du géocodage, jamais saisies à la main
  latitude    Float?
  longitude   Float?
  geocodedAt  DateTime?

  // ── Valorisation ──
  /// DVF_AUTO | MANUAL — seul DVF_AUTO est réévalué automatiquement.
  /// Une valeur corrigée par l'utilisateur n'est jamais écrasée.
  valuationMode  String    @default("MANUAL")
  lastValuedAt   DateTime?
  /// Dernière estimation DVF, conservée même si l'utilisateur l'a corrigée —
  /// permet d'afficher l'écart sans rien imposer.
  dvfEstimateEur Decimal?  @db.Decimal(14, 2)
  dvfConfidence  String?
  dvfComparables Int?

  // ── Régime fiscal et dispositif ──
  /// MICRO_FONCIER | REEL_FONCIER | MICRO_BIC | REEL_BIC | LMP
  /// Null tant que le bien n'est pas loué. Le mode de location (nu / meublé)
  /// découle de `usage` et n'est pas dupliqué ici.
  rentalRegime          String?
  /// PINEL | DENORMANDIE | MALRAUX | … — orthogonal au régime : un Pinel reste
  /// un locatif nu déclaré au foncier, assorti d'une réduction d'impôt.
  taxScheme             String?
  /// Fin de l'engagement de location (Pinel 6/9/12 ans, Denormandie…).
  /// Conservée parce qu'une sortie anticipée fait reprendre la réduction.
  commitmentEndDate     DateTime?
  /// Meublé de tourisme classé — ouvre l'abattement micro-BIC majoré (71 %).
  isClassifiedTourism   Boolean   @default(false)
  /// Année de l'investissement — détermine le barème du dispositif, qui a été
  /// raboté en 2023 puis en 2024 pour le Pinel.
  schemeStartYear       Int?
  /// Durée d'engagement en années (6, 9 ou 12 en Pinel).
  schemeCommitmentYears Int?
  /// Base du dispositif : prix de revient du logement, ou montant des travaux
  /// pour Malraux. Distincte du prix d'acquisition au journal, qui inclut les
  /// frais et ne correspond pas à l'assiette légale.
  schemeBaseEur         Decimal?  @db.Decimal(14, 2)
  /// Taux Malraux retenu : 30 % (PSMV) ou 22 % (PVAP).
  schemeRatePct         Decimal?  @db.Decimal(6, 3)

  // ── Exploitation ──
  monthlyRentEur       Decimal? @db.Decimal(12, 2)
  monthlyChargesEur    Decimal? @db.Decimal(12, 2)
  annualPropertyTaxEur Decimal? @db.Decimal(12, 2)
  /// Taux d'occupation moyen en % — surtout utile en location saisonnière
  occupancyRatePct     Decimal? @db.Decimal(5, 2)

  // ── Écritures récurrentes ──
  /// Jour du mois d'encaissement du loyer (1–31), null = pas d'automatisation.
  /// Le mécanisme reprend celui de `Liability.paymentDay` : même calcul
  /// d'échéances, même curseur, plutôt qu'un second planificateur.
  rentDay              Int?
  /// Dernière échéance de loyer déjà générée — curseur de reprise.
  lastRentAppliedAt    DateTime?
  /// Dernière échéance de charges déjà générée.
  lastChargesAppliedAt DateTime?
  /// Début de la période locative (première échéance possible).
  rentalStartDate      DateTime?
  /// Fin du bail — au-delà, plus aucune échéance n'est générée.
  rentalEndDate        DateTime?

  // ── Descriptif ──
  constructionYear Int?
  /// DPE : A à G
  energyRating     String?
  parkingSpots     Int?
  floor            Int?
  hasElevator      Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

// ─── DVF — référentiel des ventes immobilières (données publiques) ────────────

/// Vente immobilière issue des données DVF (Etalab), **agrégée au niveau
/// mutation**.
///
/// Un fichier DVF a une ligne par lot, pas par vente : une maison vendue avec
/// son garage et son terrain produit plusieurs lignes qui partagent le même
/// `id_mutation` et **répètent** la même `valeur_fonciere`. Traiter chaque
/// ligne comme une vente compterait la même transaction plusieurs fois dans
/// les comparables ; sommer les valeurs foncières triplerait le prix. Le
/// regroupement est donc fait une fois pour toutes à l'import.
///
/// Contrairement au reste du schéma, ce modèle n'a **pas** de `userId` : ce
/// sont des données publiques, identiques pour tous les comptes, et aucune
/// donnée utilisateur n'y transite. Ce n'est pas un oubli d'isolation, c'est un
/// référentiel partagé, reconstructible intégralement depuis la source.
model DvfSale {
  id            String   @id @default(cuid())
  /// id_mutation DVF — plusieurs lignes source partagent cet identifiant
  mutationId    String
  soldOn        DateTime
  /// MAISON | APPARTEMENT
  propertyType  String
  /// valeur_fonciere de la mutation entière, en euros
  valueEur      Decimal  @db.Decimal(14, 2)
  /// Somme des surfaces bâties des SEULS locaux d'habitation — inclure le
  /// garage gonflerait la surface et écraserait le prix au m².
  builtAreaM2   Int
  rooms         Int
  landAreaM2    Int?
  /// valueEur / builtAreaM2 — dénormalisé : filtre d'aberrations et tri
  pricePerM2    Decimal  @db.Decimal(12, 2)
  latitude      Float
  longitude     Float
  postalCode    String?
  inseeCode     String
  communeName   String
  department    String
  /// La mutation portait aussi un garage / parking / dépendance
  hasDependency Boolean  @default(false)
  /// Nombre de lignes DVF fusionnées — trace d'audit
  sourceRows    Int      @default(1)
  importId      String

  import DvfImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([mutationId, propertyType])
  @@index([latitude, longitude])
  @@index([department, soldOn])
  @@index([inseeCode])
  @@index([importId])
}

/// Traçabilité d'un chargement DVF : un département × un millésime.
/// L'unicité `(department, year)` rend l'import rejouable — recharger un
/// millésime remplace ses ventes au lieu de les dupliquer.
model DvfImport {
  id            String    @id @default(cuid())
  department    String
  year          Int
  sourceUrl     String
  /// RUNNING | DONE | ERROR
  status        String    @default("RUNNING")
  rowsRead      Int       @default(0)
  salesStored   Int       @default(0)
  rejected      Int       @default(0)
  /// Décompte par motif de rejet — permet de voir ce qui a été écarté
  rejectReasons Json?
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  error         String?

  sales DvfSale[]

  @@unique([department, year])
}

model PortfolioSnapshot {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime @default(now())
  totalValueEur    Decimal  @db.Decimal(28, 12)
  totalCostEur     Decimal  @db.Decimal(28, 12)
  cashTotalEur     Decimal  @db.Decimal(28, 12)
  realizedPnlEur   Decimal  @db.Decimal(28, 12)
  unrealizedPnlEur Decimal  @db.Decimal(28, 12)
  cashIncomeEur    Decimal  @db.Decimal(28, 12)
  assetCount       Int
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

/// Debts / crédits — amortissement dynamique + événements de vie
model Liability {
  id                   String    @id @default(cuid())
  userId               String
  name                 String
  initialAmount        Decimal   @db.Decimal(28, 12)
  remainingAmount      Decimal   @db.Decimal(28, 12)
  currency             String    @default("EUR")
  interestRate         Decimal?  @db.Decimal(10, 6)
  monthlyPayment       Decimal?  @db.Decimal(28, 12)
  startDate            DateTime?
  endDate              DateTime?
  /// Day of month for automatic debit (1–31). Clamped to last day of short months.
  paymentDay           Int?
  /// Last payment-day date for which a monthly debit was applied
  lastPaymentAppliedAt DateTime?
  /// Free-text bank / lender name
  bankName             String?
  notes                String?
  /// Bien financé par ce prêt (optionnel).
  ///
  /// Sert à **l'attribution**, pas au calcul du patrimoine net : celui-ci
  /// déduit déjà l'ensemble des passifs. Le lien permet d'afficher le net par
  /// bien (valeur − capital restant dû) et le rendement sur fonds propres.
  ///
  /// `remainingAmount` reste le montant réellement dû, jamais pondéré par la
  /// quote-part de propriété : on peut détenir la moitié d'un bien tout en
  /// étant solidaire de la totalité de l'emprunt.
  assetId              String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset  Asset?           @relation(fields: [assetId], references: [id], onDelete: SetNull)
  events LiabilityEvent[]

  @@index([userId])
  @@index([assetId])
}

/// Lifecycle events: monthly debit, early repayment, payment amendment
model LiabilityEvent {
  id             String   @id @default(cuid())
  liabilityId    String
  /// MONTHLY_DEBIT | EARLY_REPAYMENT_PARTIAL | EARLY_REPAYMENT_TOTAL | PAYMENT_CHANGE
  type           String
  amount         Decimal? @db.Decimal(28, 12)
  /// Remaining capital after this event
  remainingAfter Decimal? @db.Decimal(28, 12)
  eventDate      DateTime
  notes          String?
  createdAt      DateTime @default(now())

  liability Liability @relation(fields: [liabilityId], references: [id], onDelete: Cascade)

  @@index([liabilityId, eventDate])
}

// ─── Banques ──────────────────────────────────────────────────────────────────

/// Compte courant — balance defaults 0, only counts in net worth if > 0
model BankAccount {
  id           String   @id @default(cuid())
  userId       String
  /// Bank label (dropdown list or free text stored as string)
  bankName     String
  balance      Decimal  @default(0) @db.Decimal(28, 12)
  currency     String   @default("EUR")
  /// Exclu du patrimoine personnel : un compte pro ne s'additionne pas au
  /// patrimoine net comme un compte perso, même s'il figure dans la liste.
  isPro        Boolean  @default(false)
  /// Part détenue sur un compte joint, 0–100. Null = compte individuel
  /// (100 % implicite) — ne pas stocker 100 par défaut évite de confondre
  /// « non renseigné » et « joint à parts égales ».
  ownershipPct Decimal? @db.Decimal(6, 3)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  events BankAccountEvent[]

  @@index([userId])
}

/// Historique des mouvements d'un compte courant — sur le modèle de
/// `LiabilityEvent`. Généré à chaque changement de solde, jamais saisi à la
/// main : c'est ce qui permet une courbe d'évolution fiable, contrairement à
/// un journal que l'utilisateur devrait renseigner lui-même en plus du solde.
model BankAccountEvent {
  id            String   @id @default(cuid())
  bankAccountId String
  /// OPENING | DEPOSIT | WITHDRAWAL
  type          String
  /// Delta signé — positif pour un dépôt, négatif pour un retrait.
  amount        Decimal  @db.Decimal(28, 12)
  balanceAfter  Decimal  @db.Decimal(28, 12)
  occurredAt    DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([bankAccountId, occurredAt])
}

/// Livret d'épargne — intérêts planifiés (APR/APY × périodicité)
model SavingsAccount {
  id               String    @id @default(cuid())
  userId           String
  name             String
  /// Banque de détention (aligné comptes courants / plateformes)
  bankName         String?
  /// LIVRET_A | LDDS | LEP | PEL | CEL | AUTRE — détermine le plafond légal
  /// suggéré (voir `regulated-products.ts`) ; un livret bancaire non
  /// réglementé (AUTRE) n'a pas de plafond imposé.
  productType      String    @default("AUTRE")
  /// Plafond de versement (hors intérêts capitalisés). Saisi par
  /// l'utilisateur ou pré-rempli depuis `productType` — jamais recalculé en
  /// silence : un plafond légal change par décret, pas par notre code.
  ceilingAmount    Decimal?  @db.Decimal(28, 12)
  /// Principal / last booked balance (crédité aux dates de versement)
  balance          Decimal   @default(0) @db.Decimal(28, 12)
  /// Taux annuel saisi en % (ex. 3.0 = 3%) — interprété selon rateType
  apyPercent       Decimal   @default(0) @db.Decimal(10, 6)
  /// APR (linéaire) | APY (composé rétro-calculé)
  rateType         String    @default("APY")
  /// DAILY | WEEKLY | MONTHLY | YEARLY
  payoutFrequency  String    @default("DAILY")
  /// ISO weekday 1=Lundi … 7=Dimanche (WEEKLY)
  payoutDayOfWeek  Int?
  /// Jour du mois 1–31 (MONTHLY / YEARLY)
  payoutDayOfMonth Int?
  /// Mois 1–12 (YEARLY)
  payoutMonth      Int?
  /// Dernier versement d'intérêts crédité au solde
  lastPayoutAt     DateTime?
  /// Horloge d'affichage (intérêts courus non encore versés)
  lastAccruedAt    DateTime  @default(now())
  currency         String    @default("EUR")
  /// Cf. BankAccount.isPro
  isPro            Boolean   @default(false)
  /// Cf. BankAccount.ownershipPct
  ownershipPct     Decimal?  @db.Decimal(6, 3)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  events SavingsAccountEvent[]

  @@index([userId])
}

/// Historique d'un livret — mêmes principes que `BankAccountEvent`, plus le
/// type `INTEREST` : un versement d'intérêts n'est ni un dépôt ni un retrait
/// de l'utilisateur, le confondre avec l'un des deux fausserait la lecture
/// « qu'est-ce que j'ai épargné moi-même vs. ce que le taux m'a rapporté ».
model SavingsAccountEvent {
  id               String   @id @default(cuid())
  savingsAccountId String
  /// OPENING | DEPOSIT | WITHDRAWAL | INTEREST
  type             String
  amount           Decimal  @db.Decimal(28, 12)
  balanceAfter     Decimal  @db.Decimal(28, 12)
  occurredAt       DateTime @default(now())
  notes            String?
  createdAt        DateTime @default(now())

  savingsAccount SavingsAccount @relation(fields: [savingsAccountId], references: [id], onDelete: Cascade)

  @@index([savingsAccountId, occurredAt])
}

/// Dépôt à terme (CAT) — durée fixe, taux figé à l'ouverture, pénalité en cas
/// de retrait anticipé. Modèle distinct d'un livret : un CAT n'a ni
/// versement libre ni capitalisation périodique, sa mécanique (échéance +
/// pénalité) n'a presque aucun champ en commun avec `SavingsAccount`.
model TermDeposit {
  id                        String   @id @default(cuid())
  userId                    String
  bankName                  String?
  principal                 Decimal  @db.Decimal(28, 12)
  /// Taux annuel fixé à l'ouverture, en % — ne varie pas sur la durée du CAT.
  ratePercent               Decimal  @db.Decimal(10, 6)
  currency                  String   @default("EUR")
  openedAt                  DateTime
  maturityDate              DateTime
  /// % du taux perdu en cas de retrait avant échéance — null = non renseigné.
  earlyWithdrawalPenaltyPct Decimal? @db.Decimal(6, 3)
  isPro                     Boolean  @default(false)
  ownershipPct              Decimal? @db.Decimal(6, 3)
  notes                     String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Assurance-Vie ────────────────────────────────────────────────────────────

model LifeInsurance {
  id                    String    @id @default(cuid())
  userId                String
  insurer               String
  openDate              DateTime?
  /// Cash / fonds euro
  cashEuro              Decimal   @default(0) @db.Decimal(28, 12)
  currency              String    @default("EUR")
  notes                 String?
  /// Cumul des versements effectués avant le 27/09/2017 (seuil fiscal PFU).
  premiumsBefore2017Eur Decimal   @default(0) @db.Decimal(28, 12)
  /// Cumul des versements effectués à compter du 27/09/2017.
  premiumsAfter2017Eur  Decimal   @default(0) @db.Decimal(28, 12)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  products LifeInsuranceProduct[]
  supports LifeInsuranceSupport[]

  @@index([userId])
}

/// Support d'un contrat d'assurance-vie — extension 1:1 de `Asset`, sur le
/// modèle de `RealEstateDetail`.
///
/// ## Pourquoi une table d'extension
///
/// Un support d'AV est une position comme une autre : sa valeur et son prix de
/// revient viennent du journal de transactions, pas d'ici. Ce qui vit ici, c'est
/// ce que le journal ne sait pas porter — le contrat de rattachement, et les
/// caractéristiques d'un produit structuré. Les mettre sur `Asset` imposerait
/// vingt colonnes vides à chaque action et chaque crypto.
///
/// ## Le lien au contrat
///
/// `lifeInsuranceId` comble le maillon qui manquait : rien ne reliait
/// techniquement une position AV à son contrat, si bien que le rapprochement
/// devait se faire par nom — au risque de confondre deux supports homonymes
/// détenus chez deux assureurs.
///
/// ## Champs structurés
///
/// Ils ne concernent que `kind = "STRUCTURED"` et sont donc tous facultatifs. Un
/// fonds euro ou une UC classique n'a ni barrière ni date de constatation ;
/// exiger ces champs pour tous aurait obligé à inventer des valeurs.
model LifeInsuranceSupport {
  id              String  @id @default(cuid())
  assetId         String  @unique
  /// Contrat de rattachement — null si le support n'a pas encore été rattaché
  lifeInsuranceId String?

  /// FONDS_EURO | UC | STRUCTURED
  kind String @default("UC")

  // ── Identification (tous supports) ────────────────────────────────────────
  isin   String?
  /// Société de gestion (UC) ou émetteur (structuré)
  issuer String?

  // ── Produit structuré uniquement ──────────────────────────────────────────
  /// Sous-jacent : indice, action ou panier (« Euro Stoxx 50 »)
  underlying  String?
  /// Nominal souscrit, en euros
  nominalEur  Decimal? @db.Decimal(28, 12)
  /// Niveau initial de constatation du sous-jacent (strike)
  strikeLevel Decimal? @db.Decimal(28, 12)

  /// Coupon annuel, en %
  couponRatePct    Decimal? @db.Decimal(10, 6)
  /// MONTHLY | QUARTERLY | SEMIANNUAL | ANNUAL | MATURITY
  couponFrequency  String   @default("ANNUAL")
  /// Barrière de versement du coupon, en % du niveau initial
  couponBarrierPct Decimal? @db.Decimal(10, 6)
  /// Coupon à mémoire : les coupons non versés se rattrapent
  couponMemory     Boolean  @default(false)

  /// Barrière de rappel anticipé (autocall), en % du niveau initial
  autocallBarrierPct   Decimal? @db.Decimal(10, 6)
  /// Barrière de protection du capital à l'échéance, en % du niveau initial
  capitalProtectionPct Decimal? @db.Decimal(10, 6)

  /// Date de constatation initiale
  strikeDate          DateTime?
  /// Échéance finale
  maturityDate        DateTime?
  /// Prochaine date de constatation (coupon / rappel)
  nextObservationDate DateTime?
  /// Dernière constatation confirmée — curseur, comme les loyers
  lastCouponAppliedAt DateTime?

  /// Frais d'entrée sur le support, en %
  entryFeePct      Decimal? @db.Decimal(10, 6)
  /// Frais de gestion annuels sur encours, en %
  managementFeePct Decimal? @db.Decimal(10, 6)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset         Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  lifeInsurance LifeInsurance? @relation(fields: [lifeInsuranceId], references: [id], onDelete: SetNull)

  @@index([lifeInsuranceId])
  @@index([kind])
}

model LifeInsuranceProduct {
  id              String   @id @default(cuid())
  lifeInsuranceId String
  name            String
  currentValue    Decimal  @default(0) @db.Decimal(28, 12)
  currency        String   @default("EUR")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lifeInsurance LifeInsurance @relation(fields: [lifeInsuranceId], references: [id], onDelete: Cascade)

  @@index([lifeInsuranceId])
}

// ─── Épargne salariale (PEE / PER / PERCO) ────────────────────────────────────

/// Ligne de position FCPE (parts × VL) rattachée à un plan et un gestionnaire
model EmployeeSavingsLine {
  id     String @id @default(cuid())
  userId String

  /// PEE | PER | PERCO
  planType String
  /// Gestionnaire : Amundi, Natixis, AXA, Sharinbox…
  manager  String
  /// Nom du fonds (FCPE)
  fundName String
  /// Code ISIN (sync cours future)
  isin     String?
  /// Nombre de parts
  units    Decimal @default(0) @db.Decimal(28, 12)
  /// Valeur liquidative (NAV)
  nav      Decimal @default(0) @db.Decimal(28, 12)
  currency String  @default("EUR")

  /// Origine des fonds : VOLUNTARY | INTERESTEMENT | PARTICIPATION | ABONDEMENT
  sourceType String @default("VOLUNTARY")

  /// Date d'origine du versement (base pour +5 ans PEE)
  contributionDate DateTime?
  /// Date de déblocage théorique (null si mode RETIREMENT)
  unlockDate       DateTime?
  /// DATE | RETIREMENT
  unlockMode       String    @default("DATE")

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, planType])
  @@index([userId, manager])
  @@index([isin])
}

// ─── Actifs alternatifs — Métaux précieux ─────────────────────────────────────

/// Lot de métal précieux (physique ou papier), hors ledger titres.
///
/// Un lot = une acquisition homogène : même produit, même date, même prix.
/// Ce grain est imposé par la fiscalité — l'abattement pour durée de détention
/// de l'article 150 VI CGI se compte lot par lot, une moyenne le fausserait.
model PreciousMetalPosition {
  id     String @id @default(cuid())
  userId String

  /// GOLD | SILVER | PLATINUM | PALLADIUM | OTHER
  metal             String   @default("GOLD")
  /// PHYSICAL | PAPER
  format            String   @default("PHYSICAL")
  /// COIN | BAR | JEWELRY | ETC | MINING | OTHER
  productType       String   @default("COIN")
  /// Ex. Napoléon 20F, Lingot 1 kg, Krugerrand
  denomination      String
  /// Titre du métal en millièmes (900 pour un Napoléon, 999,9 pour un lingot)
  fineness          Decimal  @default(999) @db.Decimal(6, 2)
  /// Nombre de pièces / barres / unités
  quantity          Decimal  @default(0) @db.Decimal(28, 12)
  /// Poids unitaire brut en grammes (convertir Oz → g côté app)
  unitWeightG       Decimal  @default(0) @db.Decimal(28, 12)
  /// GRAM | OZ — unité saisie pour le poids unitaire
  weightUnit        String   @default("GRAM")
  /// Prix de revient unitaire (PRU), frais d'acquisition exclus
  purchasePriceUnit Decimal  @default(0) @db.Decimal(28, 12)
  /// Frais d'acquisition du lot (commission, port, assurance)
  acquisitionFees   Decimal  @default(0) @db.Decimal(28, 12)
  /// Date d'acquisition — sans elle, l'abattement pour durée de détention
  /// est incalculable et l'option pour le régime réel est fermée.
  acquiredAt        DateTime?
  /// Facture nominative et datée conservée : condition de l'option 2092-SD
  hasInvoice        Boolean  @default(false)
  /// Valeur actuelle totale de la ligne (saisie manuelle pour l'instant)
  currentValue      Decimal  @default(0) @db.Decimal(28, 12)
  currency          String   @default("EUR")
  /// Lieu de stockage (coffre, domicile, banque…)
  storageLocation   String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sales PreciousMetalSale[]

  @@index([userId])
  @@index([userId, metal])
  @@index([userId, format])
}

/// Cession d'un lot de métal précieux — le fait générateur de l'impôt.
///
/// La ligne détenue ne dit rien de la fiscalité : seule la vente déclenche,
/// au choix du cédant, la taxe forfaitaire (2091-SD) ou le régime des
/// plus-values sur biens meubles (option 2092-SD).
model PreciousMetalSale {
  id         String  @id @default(cuid())
  userId     String
  positionId String?

  /// Libellé figé au moment de la vente : le lot peut disparaître ensuite
  denomination  String
  /// Quantité cédée (unités du lot)
  quantity      Decimal  @default(0) @db.Decimal(28, 12)
  /// Prix de cession brut — assiette de la taxe forfaitaire
  salePriceEur  Decimal  @default(0) @db.Decimal(28, 12)
  /// Frais de vente, déductibles du seul régime réel
  saleFeesEur   Decimal  @default(0) @db.Decimal(28, 12)
  /// Prix d'acquisition retenu pour la quantité cédée (frais inclus)
  costBasisEur  Decimal  @default(0) @db.Decimal(28, 12)
  soldAt        DateTime
  acquiredAt    DateTime?
  /// FORFAIT | PLUS_VALUE — régime effectivement déclaré
  regime        String   @default("FORFAIT")
  hasInvoice    Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  position PreciousMetalPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, soldAt])
  @@index([positionId])
}

/// Private equity / non-coté (PME, startups, crowdequity…)
model PrivateEquityPosition {
  id     String @id @default(cuid())
  userId String

  /// Nom de la société
  companyName              String
  sector                   String?
  /// CROWDEQUITY | CLUB_DEAL | DIRECT | HOLDING
  peType                   String    @default("DIRECT")
  shares                   Decimal   @default(0) @db.Decimal(28, 12)
  /// Prix d'acquisition par part
  acquisitionPricePerShare Decimal   @default(0) @db.Decimal(28, 12)
  investmentDate           DateTime?
  /// Valorisation actuelle totale de la ligne (NAV manuelle)
  currentNav               Decimal   @default(0) @db.Decimal(28, 12)
  currency                 String    @default("EUR")
  notes                    String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, peType])
}

/// Crowdlending / dette privée (prêts participatifs)
model CrowdlendingPosition {
  id     String @id @default(cuid())
  userId String

  projectName        String
  platform           String?
  /// Capital investi
  capitalInvested    Decimal   @default(0) @db.Decimal(28, 12)
  /// Taux d'intérêt annuel en %
  annualYieldPercent Decimal   @default(0) @db.Decimal(10, 6)
  /// Durée en mois
  durationMonths     Int       @default(12)
  /// IN_FINE | AMORTIZING
  repaymentType      String    @default("IN_FINE")
  startDate          DateTime?
  /// Date d'échéance théorique
  maturityDate       DateTime?
  /// ACTIVE | LATE | REPAID | DEFAULT
  status             String    @default("ACTIVE")
  currency           String    @default("EUR")
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
}

/// Objets de valeur / collection (montres, vins, art, auto…)
model TangibleAsset {
  id     String @id @default(cuid())
  userId String

  /// WATCHES | WINE | ART | AUTO | JEWELRY | GEMSTONE | HANDBAG | INSTRUMENT
  /// | NUMISMATICS | PHILATELY | FURNITURE | OTHER
  category       String   @default("OTHER")
  /// Marque ou artiste
  brandOrArtist  String
  /// Modèle / nom de l'œuvre
  modelName      String
  /// Année ou millésime (texte libre)
  yearOrVintage  String?
  purchasePrice  Decimal  @default(0) @db.Decimal(28, 12)
  /// Valeur estimée actuelle (saisie manuelle)
  estimatedValue Decimal  @default(0) @db.Decimal(28, 12)
  currency       String   @default("EUR")
  hasCertificate Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // ── Acquisition ────────────────────────────────────────────────────────────
  /// Date d'achat — sans elle, l'abattement pour durée de détention est
  /// incalculable et l'option pour le régime réel est fermée.
  purchaseDate     DateTime?
  /// Vendeur, maison de vente, succession…
  purchaseSource   String?
  /// Numéro de certificat (GIA, LFG, carte Rolex…)
  certificateRef    String?
  /// Organisme certificateur (GIA, IGI, LFG, manufacture…)
  certificateIssuer String?
  /// Justificatifs d'achat conservés — facture, acte de vente, bordereau
  /// d'adjudication.
  ///
  /// À ne pas confondre avec `hasCertificate` : un certificat d'authenticité
  /// atteste ce qu'est l'objet, pas ce qu'il a coûté ni quand il a été acquis.
  /// Seul le justificatif d'achat ouvre l'option pour le régime réel.
  hasPurchaseProof  Boolean @default(false)
  /// Frais d'acquisition — commissaire-priseur, expertise, transport. Ils
  /// entrent dans le prix de revient et réduisent donc la plus-value taxable.
  acquisitionFees   Decimal? @db.Decimal(28, 12)

  // ── Valorisation & conservation ────────────────────────────────────────────
  /// Valeur d'expertise (notaire, assureur) — distincte de la valeur de marché
  appraisalValue  Decimal? @db.Decimal(28, 12)
  appraisalDate   DateTime?
  /// Valeur assurée, souvent supérieure à l'estimation de revente
  insuranceValue  Decimal? @db.Decimal(28, 12)
  storageLocation String?

  // ── Assurance ──────────────────────────────────────────────────────────────
  /// Prime annuelle payée — distincte du capital assuré (`insuranceValue`),
  /// que l'on confond souvent : l'une est un coût, l'autre une couverture.
  insurancePremiumAnnual Decimal? @db.Decimal(28, 12)
  insuranceProvider      String?
  insurancePolicyRef     String?

  // ── Garde / conservation ───────────────────────────────────────────────────
  /// HOME | BANK_VAULT | PRO_VAULT | THIRD_PARTY
  ///
  /// Détermine l'exposition réelle : un objet de valeur conservé au domicile
  /// sans assurance est le cas que l'écran doit signaler.
  storageType        String?
  /// Loyer annuel du coffre, de la cave ou du dépositaire
  storageCostAnnual  Decimal? @db.Decimal(28, 12)
  /// Coffreo, banque, caviste, garde-meuble…
  storageProvider    String?
  storageContractRef String?
  /// Échéance du contrat de garde — un renouvellement manqué laisse l'objet
  /// sans dépositaire déclaré.
  storageRenewalDate DateTime?

  // ── Transmission ───────────────────────────────────────────────────────────
  /// Inclus dans l'assiette successorale.
  ///
  /// Aucun barème n'est calculé ici : les droits de succession relèvent d'un
  /// chantier à part. Ce champ ne sert qu'à distinguer ce qui a déjà été donné
  /// de ce qui reste à transmettre.
  includeInEstate Boolean @default(true)
  estateNote      String?

  /// Objet de collection au sens fiscal.
  ///
  /// Décisif pour les véhicules et le mobilier : exonérés par nature
  /// (art. 150 UA II 1°), ils redeviennent imposables lorsqu'ils sont des
  /// objets de collection. Le champ ne se déduit pas de la catégorie.
  isCollectible Boolean @default(false)

  // ── Champs JEWELRY / GEMSTONE ──────────────────────────────────────────────
  /// DIAMOND | RUBY | EMERALD | SAPPHIRE | PEARL | OTHER
  gemType      String?
  /// Poids en carats
  caratWeight  Decimal? @db.Decimal(12, 4)
  /// FL | IF | VVS1 | VVS2 | VS1 | VS2 | SI1 | SI2
  gemClarity   String?
  /// D-Z (diamant) ou description libre
  gemColor     String?
  /// ROUND | PRINCESS | OVAL | PEAR | CUSHION | EMERALD_CUT | OTHER
  gemCut       String?
  /// NONE | HEATED | FRACTURE_FILLED | SYNTHETIC
  gemTreatment String?
  /// Cachemire, Myanmar, Colombie…
  gemOrigin    String?

  // ── Champs JEWELRY ─────────────────────────────────────────────────────────
  /// RING | NECKLACE | BRACELET | EARRINGS | BROOCH | OTHER
  jewelryType   String?
  /// GOLD_750 | GOLD_585 | SILVER_925 | PLATINUM_950
  metalBase     String?
  /// Poids du métal en grammes
  metalWeightG  Decimal? @db.Decimal(12, 4)
  /// Poinçons d'État présents
  hasPunchmarks Boolean?

  // ── Champs WATCHES ─────────────────────────────────────────────────────────
  /// AUTOMATIC | MANUAL | QUARTZ | SOLAR
  watchMovement   String?
  watchDiameterMm Decimal? @db.Decimal(8, 2)
  /// Référence fabricant (ex. 126610LN)
  watchReference  String?
  /// Boîte et papiers présents
  watchBoxPapers  Boolean?

  // ── Champs WINE ────────────────────────────────────────────────────────────
  wineAppellation  String?
  /// Nombre de bouteilles / magnums
  wineBottleCount  Int?
  /// BOTTLE_75 | MAGNUM | JEROBOAM | OTHER
  wineBottleFormat String?
  /// CAVE_PERSO | CAVE_LOUEE | COURTIER
  wineStorageType  String?

  // ── Champs AUTO ────────────────────────────────────────────────────────────
  autoMileageKm      Int?
  autoRegistration   String?
  /// Contrôle technique à jour
  autoInspectionOk   Boolean?
  autoPreviousOwners Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, category])
}

// ─── Poches cash CTO / PEA / AV ───────────────────────────────────────────────

/// Explicit cash pocket per fiscal envelope (not from ledger)
model EnvelopeCash {
  id        String   @id @default(cuid())
  userId    String
  /// CTO | PEA | AV
  envelope  String
  balance   Decimal  @default(0) @db.Decimal(28, 12)
  /// PEA forced EUR at app layer
  currency  String   @default("EUR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, envelope])
  @@index([userId])
}

/// Compte titres détenu chez un courtier — PEA, PEA-PME ou compte-titres
/// ordinaire.
///
/// Ce que ce modèle apporte et que `Asset.accountType` ne pouvait pas porter :
/// une **date d'ouverture**. Sans elle, la règle des 5 ans du PEA — qui décide
/// à elle seule si une plus-value est imposée à l'impôt sur le revenu — est
/// incalculable. Le reste (courtier, IBAN) n'est que du contexte ; c'est
/// `openDate` qui justifie l'existence de la table.
///
/// L'enveloppe fiscale reste par ailleurs portée par `Asset.accountType` :
/// ce modèle ne la remplace pas, il désigne *quel compte* de cette enveloppe
/// détient la ligne — distinction qui n'a de sens que depuis qu'on admet
/// plusieurs CTO chez plusieurs courtiers.
///
/// La cardinalité n'est volontairement pas la même selon l'enveloppe : le CTO
/// est libre, tandis que PEA et PEA-PME sont limités à un par personne par la
/// loi. Cette asymétrie est garantie en base par un index unique **partiel**
/// (voir la migration) plutôt que par un `@@unique` complet, qui interdirait
/// aussi le second CTO.
model SecuritiesAccount {
  id     String @id @default(cuid())
  userId String

  /// PEA | PEA_PME | CTO
  envelopeType String
  /// Courtier teneur de compte — réutilise `Platform`, qui porte déjà nom et
  /// logo. Restrict : supprimer un courtier encore rattaché à un compte doit
  /// échouer plutôt que d'orpheliner le compte.
  platformId   String

  /// Date d'ouverture — point de départ des 5 ans du PEA.
  openDate DateTime
  /// IBAN du compte espèces associé, purement documentaire.
  iban     String?
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform      Platform                        @relation(fields: [platformId], references: [id], onDelete: Restrict)
  assets        Asset[]
  contributions SecuritiesAccountContribution[]

  @@index([userId])
  @@index([userId, envelopeType])
  @@index([platformId])
}

/// Versements et retraits déclarés sur un compte titres.
///
/// Table séparée plutôt qu'un simple total sur le compte, et surtout plutôt
/// qu'un calcul depuis le journal : un `APPORT` du journal est un dépôt de
/// **liquidité bancaire** rattaché à une plateforme, sans notion d'enveloppe
/// (cf. `accounting/ledger.ts`). Or un même courtier héberge couramment un PEA
/// et un CTO, et le prix de revient des positions ne dit rien des versements
/// dès lors qu'un arbitrage gagnant a été réinvesti. Aucune de ces deux
/// sources ne permet donc de reconstituer un plafond de versement juste.
///
/// Le montant cumulé conditionne le plafond légal du PEA — un chiffre qui doit
/// rester auditable : un total modifiable en place ne permettrait pas
/// d'expliquer un dépassement. Même raisonnement que `BankAccountEvent`.
model SecuritiesAccountContribution {
  id                  String @id @default(cuid())
  securitiesAccountId String

  /// DEPOSIT | WITHDRAWAL
  type      String
  /// Montant en euros, toujours positif — c'est `type` qui porte le sens.
  amountEur Decimal @db.Decimal(28, 12)

  occurredAt DateTime
  notes      String?
  createdAt  DateTime @default(now())

  /// Cascade : l'historique de versement n'a aucun sens sans son compte,
  /// contrairement aux titres, qui conservent leur propre journal.
  account SecuritiesAccount @relation(fields: [securitiesAccountId], references: [id], onDelete: Cascade)

  @@index([securitiesAccountId, occurredAt])
}

/// Véhicule immobilier détenu indirectement — SCPI, SCI, OPCI, foncière.
///
/// Extension 1:1 de `Asset`, sur le modèle de `RealEstateDetail` : la valeur
/// et le prix de revient restent au journal (parts × prix de part), seules
/// les caractéristiques du véhicule vivent ici. Aucune valorisation en
/// parallèle, donc aucun risque de double comptage.
model IndirectRealEstateDetail {
  id      String @id @default(cuid())
  assetId String @unique

  /// SCPI | SCI_IR | SCI_IS | OPCI | SIIC | GFI | AUTRE
  vehicle String
  /// Société de gestion ou gérant.
  manager String?

  /// Taux de distribution annuel affiché par la société de gestion, en %.
  /// Déclaratif : sert à comparer, pas à valoriser.
  distributionRatePct Decimal? @db.Decimal(6, 3)
  /// Ratio d'endettement du véhicule, en % — un levier élevé amplifie la
  /// baisse comme la hausse de la valeur de part.
  debtRatioPct        Decimal? @db.Decimal(6, 3)

  /// Fraction de l'actif net représentative d'immobilier imposable à l'IFI,
  /// en % (art. 965 2°). 100 pour une SCPI classique ; une part de fonds
  /// diversifié n'est taxable qu'à hauteur de sa poche immobilière.
  realEstateSharePct Decimal? @db.Decimal(6, 3)
  /// Participation détenue dans le véhicule, en %. Sert l'exonération des
  /// titres de foncières cotées détenus à moins de 5 % (art. 972 bis).
  ownershipStakePct  Decimal? @db.Decimal(9, 6)
  /// Exclusion manuelle de l'assiette IFI — laisse la main sur les cas
  /// limites plutôt que de trancher une qualification à la place du porteur.
  ifiExcluded        Boolean  @default(false)

  /// IR | IS | EXONERE — transparence fiscale du véhicule.
  taxTransparency String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

/// Position DeFi — extension 1:1 d'un Asset, jamais une table de valorisation
/// parallèle.
///
/// La valeur de la position vit dans le journal comme n'importe quelle autre
/// position : `getHoldings()` la valorise une fois et une seule. Ce modèle ne
/// porte que ce que le journal ne sait pas exprimer — le protocole, le
/// rendement, la santé d'un prêt collatéralisé.
///
/// Un emprunt est stocké ici comme une position `BORROWING` : c'est
/// `isDebtPosition()` qui lui donne son signe négatif dans les agrégats. Le
/// signe n'est jamais inscrit en base, sans quoi deux endroits décideraient de
/// la même chose.
/// Regroupement optionnel de positions DeFi liées entre elles (ex. ETH →
/// staké chez Lido → stETH déposé en collatéral chez Aave → USDC emprunté).
///
/// Ne porte aucune valeur propre : le P&L consolidé d'une stratégie est la
/// somme de `netValueEur` de ses positions au moment de la lecture, jamais
/// un champ stocké séparément — même principe que `DefiPositionDetail`
/// lui-même vis-à-vis du journal. Une position sans `strategyId` reste une
/// position autonome, exactement comme avant l'existence de ce modèle.
model DefiStrategy {
  id        String   @id @default(cuid())
  userId    String
  name      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions DefiPositionDetail[]

  @@index([userId])
}

model DefiPositionDetail {
  id      String @id @default(cuid())
  assetId String @unique

  /// Regroupement optionnel dans une stratégie multi-positions. `SetNull` :
  /// supprimer une stratégie ne doit jamais supprimer les positions qui la
  /// composent, seulement les en détacher.
  strategyId String?
  strategy   DefiStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  /// Aave, Lido, Uniswap, Kamino…
  protocol     String
  protocolLogo String?
  /// ethereum | arbitrum | base | solana…
  chain        String?
  /// STAKING | LIQUID_STAKING | LENDING | BORROWING | LP | YIELD_FARMING
  /// | VAULT | RESTAKING | RWA | LOCKED | REWARDS | OTHER
  positionType String

  /// Second actif d'une position de liquidité (le premier est porté par
  /// l'Asset lui-même).
  pairedSymbol        String?
  pairedAmount        Decimal? @db.Decimal(38, 18)
  /// Prix unitaire (EUR) du second actif au moment de l'engagement. Sans lui,
  /// l'IL ne peut pas se calculer : c'est le prix courant du premier actif
  /// (porté par Asset) qui donne l'autre moitié de la formule.
  pairedEntryPriceEur Decimal? @db.Decimal(28, 12)
  poolAddress         String?

  /// LP à 3, 4 ou 5 jetons (Curve, Balancer…) : jetons au-delà du second,
  /// chacun `{ symbol, amount, entryPriceEur, allocationPct? }`.
  ///
  /// JSON plutôt que des colonnes `token3Symbol`..`token5Symbol` : le nombre
  /// de jetons au-delà de 2 est rare et variable, des colonnes figées à 5
  /// forceraient une nouvelle migration pour un pool à 6 jetons alors qu'un
  /// tableau n'a pas de plafond arbitraire. Les deux premiers jetons restent
  /// des colonnes dédiées : ce sont eux que lit `groupByProtocol`/l'API sans
  /// désérialiser de JSON, et le cas 2-jetons (l'immense majorité des LP)
  /// reste aussi simple qu'avant cette extension.
  pairedLegs Json?

  /// Liquidité concentrée façon Uniswap V3 / Curve : la position n'est
  /// active que dans `[priceRangeMin, priceRangeMax]`. `false` = plage
  /// complète (LP classique), seul cas où ces trois champs restent vides.
  isConcentrated Boolean  @default(false)
  priceRangeMin  Decimal? @db.Decimal(38, 18)
  priceRangeMax  Decimal? @db.Decimal(38, 18)

  /// Répartition de la valeur déposée entre le premier et le second jeton, en
  /// %. Nulle sur une LP classique (répartition ≈ 50/50 implicite) ; posée
  /// par l'utilisateur sur une position concentrée, où l'écart au range
  /// pousse la répartition loin de 50/50.
  token1AllocationPct Decimal? @db.Decimal(6, 3)
  pairedAllocationPct Decimal? @db.Decimal(6, 3)

  /// Rendement annualisé affiché par le protocole, en %. Déclaratif : sert à
  /// comparer, jamais à valoriser.
  apyPct          Decimal? @db.Decimal(9, 4)
  /// Premier reward (conservé tel quel pour compatibilité — la quasi-totalité
  /// des positions n'en ont qu'un seul).
  rewardsSymbol   String?
  rewardsAmount   Decimal? @db.Decimal(38, 18)
  rewardsValueEur Decimal? @db.Decimal(18, 2)

  /// Rewards additionnels au-delà du premier, ex. `[{ symbol, amount,
  /// valueEur, source }]` — une LP Curve qui distribue à la fois CRV et son
  /// propre gauge token. Même raisonnement que `pairedLegs` : JSON plutôt que
  /// des colonnes `reward2Symbol`..`rewardNSymbol`, le nombre de rewards
  /// au-delà du premier est rare et sans plafond naturel.
  extraRewardLegs Json?

  /// Déblocage / vesting — tous optionnels, absents = position librement
  /// disponible (comportement actuel inchangé). `vestingSchedule` porte un
  /// vesting linéaire ou multi-tranches : `{ cliffAt?, endAt, amount }[]`.
  unlockAt        DateTime?
  cliffAt         DateTime?
  vestingSchedule Json?

  /// Sac déclaratif pour ce qui n'a pas (encore) de champ dédié — campagne de
  /// points, référence d'audit, etc. Jamais lu par un calcul, seulement
  /// affiché : un champ qui influencerait une valorisation appartient à une
  /// colonne nommée, pas ici.
  metadata Json?

  /// Santé d'un prêt collatéralisé. Sous 1, la position est liquidable.
  healthFactor    Decimal? @db.Decimal(12, 4)
  ltvPct          Decimal? @db.Decimal(6, 3)
  liqThresholdPct Decimal? @db.Decimal(6, 3)

  /// ZERION | MANUAL — une ligne saisie à la main n'est jamais écrasée par
  /// une synchronisation.
  source       String    @default("MANUAL")
  lastSyncedAt DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([protocol])
  @@index([positionType])
  @@index([strategyId])
}

/// Compte de trading à levier — CFD, futures, spread betting.
///
/// `brokerName` est une chaîne et non une relation vers `Platform`, à rebours
/// de `SecuritiesAccount` : une position de trading n'est pas un `Asset`, elle
/// n'a donc jamais eu besoin d'une plateforme, et le modèle de position porte
/// déjà son courtier sous forme de chaîne (`exchange`). Forcer la création
/// d'une `Platform` pour déclarer un compte IG ou XTB ajouterait une étape
/// sans rien apporter au calcul.
model TradingAccount {
  id     String @id @default(cuid())
  userId String

  /// IG, XTB, Saxo, Interactive Brokers, Binance…
  brokerName  String
  /// CFD | FUTURES | SPREAD_BETTING | MIXED
  accountType String @default("MIXED")

  currency        String   @default("EUR")
  /// Solde du compte, déclaratif — le P&L des positions se calcule à part.
  balance         Decimal  @default(0) @db.Decimal(28, 12)
  /// Marge encore disponible, telle qu'affichée par le courtier.
  marginAvailable Decimal? @db.Decimal(28, 12)

  openDate  DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions TradingPosition[]

  @@index([userId])
  @@index([userId, accountType])
}

/// Position à levier — CFD, future ou perpétuel, quel que soit le sous-jacent.
///
/// Rattachée directement à l'utilisateur, pas à un `Asset` : contrairement à
/// un solde ou une position DeFi, un contrat à terme n'est pas un actif
/// détenu — c'est un pari collatéralisé par une marge. Ce que la position
/// pèse au patrimoine n'est ni sa taille ni son notionnel, mais marge + P&L
/// latent, un calcul qui n'a pas de sens dans le modèle quantité × prix du
/// journal. L'étendre en extension d'Asset comme RealEstateDetail aurait
/// forcé cette sémantique où elle ne s'applique pas.
///
/// ## Pourquoi ce modèle a été généralisé plutôt que dupliqué
///
/// Il ne portait à l'origine que des futures crypto. Créer un
/// `TradingPosition` parallèle pour les CFD aurait produit deux tables de
/// positions à levier, deux calculs de P&L, deux imports et deux jeux
/// d'analytics — en laissant les futures crypto existants dans l'ancien.
/// `underlyingType` suffit à couvrir les deux mondes, `fundingPaid` étant déjà
/// l'exact équivalent crypto des frais de financement overnight d'un CFD.
///
/// La table conserve son nom d'origine (`@@map`) : le renommage ne concerne
/// que le modèle Prisma, aucune donnée n'est déplacée.
model TradingPosition {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Compte de rattachement. Nullable : les positions antérieures à
  /// `TradingAccount` restent lisibles sans compte déclaré.
  tradingAccountId String?
  tradingAccount   TradingAccount? @relation(fields: [tradingAccountId], references: [id], onDelete: SetNull)

  /// CRYPTO | INDEX | FOREX | COMMODITY | STOCK | BOND
  ///
  /// `CRYPTO` par défaut : c'est ce que contenait la table avant l'ouverture
  /// aux CFD, et le défaut préserve donc le sens des lignes existantes.
  underlyingType String @default("CRYPTO")

  /// BINANCE | BYBIT | OKX | HYPERLIQUID | DYDX | IG | XTB | SAXO | OTHER
  exchange        String
  subAccountLabel String?

  /// Identifiant de l'instrument, quel que soit le sous-jacent :
  /// « BTC/USDT-PERP », « ETH/USD-0927 », « CAC 40 », « EUR/USD »…
  ///
  /// Le nom reste `pair` — hérité des futures crypto — plutôt que renommé en
  /// `instrument` : le renommer ne changerait rien au calcul et toucherait le
  /// service, l'import CSV, l'écran et les tests.
  pair          String
  /// PERPETUAL | QUARTERLY | MONTHLY | CFD
  ///
  /// `CFD` couvre les contrats sans échéance : c'est ce qui les distingue d'un
  /// perpétuel crypto, dont le coût de portage passe par le funding.
  contractType  String  @default("PERPETUAL")
  /// USDT_M | COIN_M — propre aux futures crypto, donc absent sur un CFD.
  marginType    String?
  baseCurrency  String
  quoteCurrency String

  /// Échéance du contrat. Nulle sur un perpétuel et sur un CFD, qui n'en ont
  /// pas — c'est justement ce qui les sépare d'un future daté.
  expiryDate DateTime?
  /// Valeur d'un point de cotation, pour le calcul du risque par tick.
  tickValue  Decimal?  @db.Decimal(20, 8)

  /// LONG | SHORT
  direction        String
  leverage         Decimal  @db.Decimal(8, 2)
  sizeContracts    Decimal  @db.Decimal(28, 10)
  notionalUsd      Decimal? @db.Decimal(20, 2)
  entryPrice       Decimal  @db.Decimal(20, 8)
  markPrice        Decimal? @db.Decimal(20, 8)
  /// Dernier prix de liquidation connu de l'exchange — l'estimation servie à
  /// l'écran est recalculée, ce champ ne fait que la doubler si disponible.
  liquidationPrice Decimal? @db.Decimal(20, 8)

  marginUsed     Decimal? @db.Decimal(20, 2)
  fundingPaid    Decimal? @db.Decimal(20, 2)
  commissionPaid Decimal? @db.Decimal(20, 2)

  unrealizedPnl Decimal? @db.Decimal(20, 2)
  realizedPnl   Decimal? @db.Decimal(20, 2)

  stopLoss   Decimal? @db.Decimal(20, 8)
  takeProfit Decimal? @db.Decimal(20, 8)

  isOpen   Boolean   @default(true)
  openedAt DateTime?
  closedAt DateTime?

  /// Identifiant du trade côté exchange — clé d'upsert de l'import CSV, pour
  /// qu'un même relevé importé deux fois ne double pas les positions.
  exchangeTradeId String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, exchangeTradeId])
  @@index([userId, isOpen])
  @@index([userId, exchange])
  @@index([userId, closedAt])
  @@index([userId, underlyingType])
  @@index([tradingAccountId])
  /// La table garde son nom d'origine : le modèle est renommé, pas les
  /// données. Aucune migration de contenu, donc aucun risque pour les
  /// positions futures déjà enregistrées.
  @@map("CryptoFuturesPosition")
}

/// NFT — extension 1:1 d'un Asset, comme RealEstateDetail et DefiPositionDetail.
///
/// Un NFT est un actif détenu au sens plein : on l'a payé, il a une valeur qui
/// fluctue, on peut le céder. Il suit donc le même patron que l'immobilier ou
/// la DeFi, et pas celui des futures : le journal reste la source de vérité
/// pour la quantité et le coût de revient, ce modèle ne porte que ce qu'un
/// Asset générique ne sait pas exprimer — la collection, la rareté, et
/// l'estimation de floor price (l'équivalent de l'estimation DVF pour un
/// bien immobilier).
model NftItemDetail {
  id      String @id @default(cuid())
  assetId String @unique

  tokenId        String
  contractAddr   String?
  /// ethereum | base | polygon | arbitrum | optimism | solana
  chain          String
  collectionName String?
  collectionSlug String?
  imageUrl       String?
  metadataUrl    String?
  /// ERC_721 | ERC_1155 | SPL
  standard       String?

  /// DVF_AUTO-like : MANUAL tant que l'utilisateur fixe la valeur, FLOOR_AUTO
  /// une fois un rafraîchissement de floor price appliqué.
  valuationMode      String    @default("MANUAL")
  lastValuedAt       DateTime?
  floorPriceNative   Decimal?  @db.Decimal(24, 10)
  floorPriceCurrency String?
  floorPriceEur      Decimal?  @db.Decimal(18, 2)
  /// OPENSEA | BLUR | MAGIC_EDEN | TENSOR | RESERVOIR | MANUAL
  estimateSource     String?
  estimateDate       DateTime?

  rarityRank  Int?
  rarityScore Decimal? @db.Decimal(10, 4)

  /// Masque un spam/scam de la galerie sans supprimer la position.
  isHidden Boolean @default(false)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([chain])
  @@index([collectionSlug])
}
